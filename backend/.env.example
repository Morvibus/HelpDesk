# Copiar como backend/.env (ese archivo NUNCA se sube al repositorio).
# docker compose lo carga en el backend; sin él, el backend no arranca.

# Obligatoria: firma de los tokens de sesión. Usar una cadena larga y aleatoria, distinta en cada
# instalación (p. ej. 64 caracteres). Cambiarla cierra todas las sesiones abiertas.
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Solo para correr el backend FUERA de Docker: dentro de Docker manda la de docker-compose.yml.
DATABASE_URL=postgresql://helpdesk_user:helpdesk_password@localhost:5432/helpdesk_db
