# Por defecto el frontend llama a '/api' y el proxy de Vite lo reenvía al backend
# (API_PROXY_TARGET, por defecto http://localhost:8000; en Docker lo fija compose).
# Solo define VITE_API_URL para apuntar a un backend en otro servidor (exige CORS en el backend).
# VITE_API_URL=http://localhost:8000
